# Production backend URL (required — must not be localhost)
# Used for SSR API calls and Next.js /api/v1 rewrites
#
# Amplify Hosting: set API_URL in the Amplify console, then amplify.yml writes it
# into .env.production during build so SSR compute can read it at runtime.
API_URL=https://api.example.com

# Browser API base path — keep /api/v1 when using same-origin rewrites (recommended)
# Use a full URL only if the browser should call the API directly on another host
NEXT_PUBLIC_API_BASE=/api/v1

# Winston log level on the server
LOG_LEVEL=info
