# Local development — copy to .env.local and adjust as needed
# Validate with: npm run validate:env

# Backend API URL (SSR + Next.js /api/v1 rewrites)
API_URL=http://localhost:3000

# Browser API base — use /api/v1 to proxy through Next.js (recommended locally)
NEXT_PUBLIC_API_BASE=/api/v1

# Winston log level: error | warn | info | debug
LOG_LEVEL=debug